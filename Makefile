# =====================================================================
# 콘솔 가계부 시연 시나리오 Makefile
#
#   make demo   : 시나리오 전체 실행 + 로그 파일 저장 (logs/demo_날짜_시간.log)
#   make clean  : 시연용 데이터/CSV 삭제 (로그는 남김)
#   make clean-logs : 로그 파일까지 삭제
#   make help   : 사용법 출력
#
# 시나리오: "11월에 카페 지출 관리해 보기"
#   카테고리 추가 → 예산 설정 → 거래 추가 → 조회/검색 → 수정 → 요약
#   → CSV 내보내기 → 거래/카테고리 삭제 → 시연 데이터 정리
#
# 실제 data/ 폴더는 건드리지 않고 demo_data/ 폴더를 따로 사용한다.
# =====================================================================


# ---------------------------------------------------------------------
# [설정] 셸 / 실행 명령 / 경로
# ---------------------------------------------------------------------
# pipefail: "make ... | tee 로그" 에서 앞쪽 make 가 실패하면 전체를 실패로 처리
SHELL       := /bin/bash
.SHELLFLAGS := -o pipefail -c

PYTHON   ?= python3
DEMO_DIR := demo_data
DEMO_CSV := demo.csv
APP      := $(PYTHON) -m budget_app --data-dir $(DEMO_DIR)

# 거래 ID는 실행할 때마다 랜덤이라 파일에 저장해 두고 꺼내 쓴다
INCOME_ID_FILE  := $(DEMO_DIR)/.income_id
EXPENSE_ID_FILE := $(DEMO_DIR)/.expense_id

# 로그 파일 이름: logs/demo_20261113_171500.log
LOG_DIR  := logs
LOG_FILE := $(LOG_DIR)/demo_$(shell date +%Y%m%d_%H%M%S).log

# 단계 제목 출력용
define step
	@echo ""
	@echo "=============================================================="
	@echo "[$(1)] $(2)"
	@echo "=============================================================="
endef

# 단계 순서가 섞이지 않도록 병렬 실행 금지
.NOTPARALLEL:
.PHONY: help demo scenario clean clean-logs \
        step01 step02 step03 step04 step05 step06 step07 \
        step08 step09 step10 step11 step12 step13 step14


# ---------------------------------------------------------------------
# [사용법] make help
# ---------------------------------------------------------------------
help:
	@echo "사용법:"
	@echo "  make demo        시나리오 전체 실행 + 로그 저장 ($(LOG_DIR)/demo_*.log)"
	@echo "  make clean       시연용 데이터($(DEMO_DIR)/)와 $(DEMO_CSV) 삭제"
	@echo "  make clean-logs  로그 파일 삭제"


# ---------------------------------------------------------------------
# [진입점] make demo
#   화면 출력 + 앱 로그(stderr)를 모두 로그 파일에 저장한다 (tee)
# ---------------------------------------------------------------------
demo:
	@mkdir -p $(LOG_DIR)
	@echo "로그 파일: $(LOG_FILE)"
	@{ \
	  echo "### 가계부 시연 로그"; \
	  echo "### 실행 시각 : $$(date '+%Y-%m-%d %H:%M:%S')"; \
	  echo "### Python    : $$($(PYTHON) --version 2>&1)"; \
	  echo "### 데이터 폴더: $(DEMO_DIR)"; \
	  $(MAKE) --no-print-directory scenario; \
	} 2>&1 | tee $(LOG_FILE)
	@echo ""
	@echo "시나리오 완료. 로그 저장 위치: $(LOG_FILE)"


# ---------------------------------------------------------------------
# [시나리오] 1 ~ 14단계를 순서대로 실행
# ---------------------------------------------------------------------
scenario: step01 step02 step03 step04 step05 step06 step07 \
          step08 step09 step10 step11 step12 step13 step14


# ---------------------------------------------------------------------
# [준비] 1 ~ 2단계: 카테고리 추가, 예산 설정
# ---------------------------------------------------------------------
step01:
	$(call step,1,카테고리 추가: 카페)
	@rm -rf $(DEMO_DIR) $(DEMO_CSV)
	$(APP) category add --name 카페

step02:
	$(call step,2,11월 예산 설정: 300000원)
	$(APP) budget set --month 2026-11 --amount 300000


# ---------------------------------------------------------------------
# [거래 추가] 3 ~ 4단계: add 는 입력을 하나씩 받으므로 printf 로 넘긴다
#   입력 순서: 날짜 / 타입 / 카테고리 / 금액 / 메모 / 태그
# ---------------------------------------------------------------------
step03:
	$(call step,3,수입 추가: 11월 월급)
	printf '2026-11-01\nincome\n급여\n2500000\n11월 월급\n월급\n' | $(APP) add \
	  | tee /dev/stderr | grep '생성된 ID' | awk '{print $$NF}' > $(INCOME_ID_FILE)
	@echo "저장된 수입 ID: $$(cat $(INCOME_ID_FILE))"

step04:
	$(call step,4,지출 추가: 카페 아메리카노)
	printf '2026-11-03\nexpense\n카페\n4500\n아메리카노\n커피\n' | $(APP) add \
	  | tee /dev/stderr | grep '생성된 ID' | awk '{print $$NF}' > $(EXPENSE_ID_FILE)
	@echo "저장된 지출 ID: $$(cat $(EXPENSE_ID_FILE))"


# ---------------------------------------------------------------------
# [조회] 5 ~ 6단계: 목록, 검색
# ---------------------------------------------------------------------
step05:
	$(call step,5,거래 목록 조회)
	$(APP) list

step06:
	$(call step,6,카테고리 검색: 카페)
	$(APP) search --category 카페


# ---------------------------------------------------------------------
# [예외 확인] 7단계: 사용 중인 카테고리는 삭제가 거부되어야 정상
# ---------------------------------------------------------------------
step07:
	$(call step,7,사용 중인 카테고리 삭제 시도 → 거부되어야 정상)
	@if $(APP) category remove --name 카페; then \
	  echo "[실패] 사용 중인 카테고리가 삭제되었습니다."; exit 1; \
	else \
	  echo "[확인] 예상대로 삭제가 거부되었습니다."; \
	fi


# ---------------------------------------------------------------------
# [수정 / 요약 / 내보내기] 8 ~ 10단계
# ---------------------------------------------------------------------
step08:
	$(call step,8,지출 수정: 4500원 → 5500원 / 카페라떼)
	$(APP) update --id $$(cat $(EXPENSE_ID_FILE)) --amount 5500 --memo 카페라떼

step09:
	$(call step,9,11월 요약)
	$(APP) summary --month 2026-11

step10:
	$(call step,10,11월 거래 CSV 내보내기)
	$(APP) export --month 2026-11 --out $(DEMO_CSV)
	cat $(DEMO_CSV)


# ---------------------------------------------------------------------
# [삭제] 11 ~ 13단계: 거래 삭제 → 카테고리 삭제 → 빈 상태 확인
# ---------------------------------------------------------------------
step11:
	$(call step,11,거래 삭제: 지출 / 수입)
	$(APP) delete --id $$(cat $(EXPENSE_ID_FILE))
	$(APP) delete --id $$(cat $(INCOME_ID_FILE))

step12:
	$(call step,12,카테고리 삭제: 카페 → 이제는 성공해야 함)
	$(APP) category remove --name 카페

step13:
	$(call step,13,빈 상태 확인)
	$(APP) list


# ---------------------------------------------------------------------
# [정리] 14단계: 시연 중에 만든 데이터 폴더와 CSV 삭제
# ---------------------------------------------------------------------
step14:
	$(call step,14,시연 데이터 정리)
	rm -rf $(DEMO_DIR) $(DEMO_CSV)
	@echo "[확인] $(DEMO_DIR)/, $(DEMO_CSV) 삭제 완료"


# ---------------------------------------------------------------------
# [청소] make clean / make clean-logs
# ---------------------------------------------------------------------
clean:
	rm -rf $(DEMO_DIR) $(DEMO_CSV)

clean-logs:
	rm -rf $(LOG_DIR)
